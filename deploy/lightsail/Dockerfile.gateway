FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS dashboard-build

WORKDIR /src
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard ./
ENV NEXT_PUBLIC_BASE_PATH="" \
    NEXT_PUBLIC_MARKET_API_URL=""
RUN npm run build

FROM alpine:3.23.6@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN set -eux; \
    test "$(apk --print-arch)" = x86_64; \
    apk add --no-cache ca-certificates curl libcap mailcap; \
    wget -O /tmp/caddy.tar.gz https://github.com/caddyserver/caddy/releases/download/v2.11.6/caddy_2.11.6_linux_amd64.tar.gz; \
    echo '22c84f8d2d4e4e0e2d422f8049fdd0fc1ed8d5665d0fe166f506c7fd863b4555  /tmp/caddy.tar.gz' | sha256sum -c -; \
    tar xzf /tmp/caddy.tar.gz -C /usr/bin caddy; \
    rm -f /tmp/caddy.tar.gz; \
    chmod 0755 /usr/bin/caddy; \
    setcap cap_net_bind_service=+ep /usr/bin/caddy; \
    caddy version; \
    mkdir -p /data /config /srv; \
    addgroup -g 10000 -S caddy \
    && adduser -u 10000 -D -S -G caddy caddy \
    && chown -R caddy:caddy /data /config
LABEL org.opencontainers.image.version="2.11.6" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/caddyserver/caddy"
COPY deploy/lightsail/Caddyfile /etc/caddy/Caddyfile
COPY --from=dashboard-build --chown=caddy:caddy /src/out /srv
COPY THIRD_PARTY_NOTICES.md docs/dependency-notices.json docs/third-party-license-texts.txt /usr/share/doc/trading-platform/
ENV XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data
EXPOSE 80 443 443/udp
WORKDIR /srv
USER 10000:10000
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
